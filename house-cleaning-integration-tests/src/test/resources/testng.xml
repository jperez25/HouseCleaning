<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="HouseCleaning-Integration-Suite" verbose="1">

    <!-- Smoke tests that are safe to run concurrently. Sequential-group tests are excluded. -->
    <test name="Smoke-Parallel" parallel="methods" thread-count="4">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.occ.housecleaning.tests"/>
        </packages>
    </test>

    <!-- Regression tests that are safe to run concurrently. Sequential-group tests are excluded. -->
    <test name="Regression-Parallel" parallel="methods" thread-count="4">
        <groups>
            <run>
                <include name="regression"/>
                <exclude name="sequential"/>
            </run>
        </groups>
        <packages>
            <package name="com.occ.housecleaning.tests"/>
        </packages>
    </test>

    <!-- Tests relying on shared state run one at a time, after the parallel test above completes. -->
    <test name="Regression-Sequential" parallel="none">
        <groups>
            <run>
                <include name="sequential"/>
            </run>
        </groups>
        <packages>
            <package name="com.occ.housecleaning.tests"/>
        </packages>
    </test>

    <!-- Unit tests of the reporting package (they change system properties, so no parallelism). -->
    <test name="Reporting-Unit" parallel="none">
        <packages>
            <package name="com.occ.housecleaning.reporting"/>
        </packages>
    </test>
</suite>
